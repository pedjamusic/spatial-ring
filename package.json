{
  "name": "inventory-app",
  "workspaces": [
    "api",
    "web",
    "mobile"
  ],
  "version": "0.7.0",
  "description": "A simple inventory management system with spatial organization capabilities. Inspired by fantasy series where \"spatial rings\" create pocket dimensions for storing items.",
  "homepage": "https://github.com/pedjamusic/spatial-ring#readme",
  "bugs": {
    "url": "https://github.com/pedjamusic/spatial-ring/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedjamusic/spatial-ring.git"
  },
  "license": "ISC",
  "author": "Predrag Drljača",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "npm run dev --workspace=api & npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "dev:local": "npm run dev:local --workspace=api & npm run dev --workspace=web",
    "dev:prod": "npm run dev:prod --workspace=api & npm run dev --workspace=web",
    "build": "npm run build --workspace=api && npm run build --workspace=web",
    "setup": "npm run setup --workspace=api",
    "env:setup": "npm run env:setup --workspace=api",
    "db:setup": "npm run db:setup --workspace=api",
    "db": "npm run db --workspace=api",
    "db:generate": "npm run db:generate --workspace=api",
    "db:push": "npm run db:push --workspace=api",
    "db:migrate": "npm run db:migrate --workspace=api",
    "db:prod": "npm run db:prod --workspace=api",
    "db:generate:prod": "npm run db:generate:prod --workspace=api",
    "db:deploy:prod": "npm run db:deploy:prod --workspace=api",
    "db:test": "npm run db:test --workspace=api",
    "scaffold": "npm run scaffold --workspace=api",
    "test": "npm run test --workspace=api",
    "preview": "npm run preview --workspace=web"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "dotenv-cli": "^10.0.0",
    "prettier": "^3.6.2"
  }
}
