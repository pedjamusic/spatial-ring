# Test-only environment. Copy to api/.env.test and adjust values.
# IMPORTANT: use a dedicated test DB (different from api/.env DATABASE_URL).

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_test?schema=public"
JWT_SECRET="test-only-secret-change-me"
BCRYPT_COST=8
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
