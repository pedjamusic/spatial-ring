{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "pg": "docker start pg-local",
    "db": "dotenv -e .env -- npx prisma studio",
    "db:test": "NODE_ENV=test dotenv -e .env.test -- npx prisma studio",
    "test": "cross-env NODE_ENV=test dotenv -e .env.test -- vitest run",
    "test:watch": "cross-env NODE_ENV=test dotenv -e .env.test -- vitest",
    "test:setup": "cross-env NODE_ENV=test dotenv -e .env.test -- npx prisma db push --force-reset",
    "gen": "npm run gen:resources && npm run gen:ui-configs",
    "gen:resources": "node scripts/generate-resources.mjs",
    "gen:ui-configs": "node scripts/generate-ui-configs.mjs",
    "build": "npm run gen"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemon": "^3.1.10"
  },
  "devDependencies": {
    "@prisma/internals": "^6.17.1",
    "cross-env": "^10.0.0",
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.16.2",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
