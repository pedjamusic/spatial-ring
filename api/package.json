{
  "name": "api",
  "version": "0.8.3",
  "description": "",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:prod": "dotenv -e .env.production -- nodemon src/server.js",
    "dev:local": "dotenv -e .env -- nodemon src/server.js",
    "pg": "docker start pg-local",
    "setup": "npm run db:setup && npm run env:setup",
    "env:setup": "node scripts/setup-env.mjs",
    "db:setup": "node scripts/setup-db.mjs --workspace=api",
    "db": "dotenv -e .env -- npx prisma studio",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:prod": "dotenv -e .env.production -- npx prisma studio",
    "db:generate:prod": "dotenv -e .env.production -- npx prisma generate --no-engine",
    "db:deploy:prod": "npx prisma migrate deploy",
    "db:test": "node scripts/check-test-env.mjs && NODE_ENV=test dotenv -e .env.test -- npx prisma studio",
    "test:env:check": "node scripts/check-test-env.mjs",
    "test": "npm run test:env:check && cross-env NODE_ENV=test dotenv -e .env.test -- vitest run",
    "test:watch": "npm run test:env:check && cross-env NODE_ENV=test dotenv -e .env.test -- vitest",
    "test:setup": "npm run test:env:check && cross-env NODE_ENV=test dotenv -e .env.test -- npx prisma db push --force-reset",
    "scaffold": "npm run scaffold:resources && npm run scaffold:ui-configs",
    "scaffold:resources": "node scripts/generate-resources.mjs",
    "scaffold:ui-configs": "node scripts/generate-ui-configs.mjs",
    "build": "exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemon": "^3.1.10"
  },
  "devDependencies": {
    "@prisma/internals": "^6.17.1",
    "prisma": "^6.16.2",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
