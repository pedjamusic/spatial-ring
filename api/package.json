{
  "name": "api",
  "version": "0.8.3",
  "engines": {
    "node": "24.x"
  },
  "description": "",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch --watch-preserve-output src/server.js",
    "dev:prod": "node --env-file=.env.production --watch --watch-preserve-output src/server.js",
    "dev:local": "node --env-file=.env --watch --watch-preserve-output src/server.js",
    "pg": "docker start pg-local",
    "setup": "npm run db:setup && npm run env:setup",
    "env:setup": "node scripts/setup-env.mjs",
    "db:setup": "node scripts/setup-db.mjs --workspace=api",
    "db": "node --env-file=.env ../node_modules/prisma/build/index.js studio",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:prod": "node --env-file=.env.production ../node_modules/prisma/build/index.js studio",
    "db:generate:prod": "node --env-file=.env.production ../node_modules/prisma/build/index.js generate",
    "db:deploy:prod": "npx prisma migrate deploy",
    "db:test": "node scripts/check-test-env.mjs && cross-env NODE_ENV=test node --env-file=.env.test ../node_modules/prisma/build/index.js studio",
    "test:env:check": "node scripts/check-test-env.mjs",
    "test": "npm run test:env:check && cross-env NODE_ENV=test node --env-file=.env.test ../node_modules/vitest/vitest.mjs run",
    "test:watch": "npm run test:env:check && cross-env NODE_ENV=test node --env-file=.env.test ../node_modules/vitest/vitest.mjs",
    "test:setup": "npm run test:env:check && cross-env NODE_ENV=test node --env-file=.env.test ../node_modules/prisma/build/index.js db push --force-reset",
    "scaffold": "npm run scaffold:resources && npm run scaffold:ui-configs",
    "scaffold:resources": "node scripts/generate-resources.mjs",
    "scaffold:ui-configs": "node scripts/generate-ui-configs.mjs",
    "build": "npm run db:generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/extension-accelerate": "^3.0.1"
  },
  "devDependencies": {
    "@prisma/internals": "^7.10.0",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
