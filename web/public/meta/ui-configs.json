  "Event": {
    "_tableConfig": {
      "defaultSort": {
        "field": "startsAt",
        "direction": "ascending"
      }
    },
    "_viewConfig": {
      "calendar": {
        "enabled": true,
        "defaultView": "month",
        "dateStartField": "startsAt",
        "dateEndField": "endsAt",
        "labelField": "name"
      }
    },
    "id": {
      "hidden": true,
      "hideFromColumnSettings": true
    },
    "createdAt": {
      "hidden": true,
      "hideFromColumnSettings": true
    },
    "locationId": {
      "hidden": true,
      "hideFromColumnSettings": true
    },
    "location": {
      "label": "Location",
      "path": "location.name"
    },
    "startsAt": {
      "dateOnly": true,
      "widget": "dateRangePicker",
      "rangeEnd": "endsAt"
    },
    "endsAt": {
      "dateOnly": true,
      "showDuration": { "fromField": "startsAt" },
      "pairedWith": "startsAt"
    },
    "notes": {
      "widget": "textarea",
      "hideInTable": true
    },
    "movements": {
      "hideFromColumnSettings": true
